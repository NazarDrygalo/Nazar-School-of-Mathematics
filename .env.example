# Required to send applications through Resend (https://resend.com)
RESEND_API_KEY=re_your_key_here
# Optional. Without a domain, Resend's testing sender is used and can only
# deliver to the email address on the Resend account. Add this after buying
# and verifying a domain, for example:
FROM_EMAIL=Nazar's School of Mathematics <applications@yourdomain.com>
# Optional. Defaults to nazar.drygalo@gmail.com.
APPLICATION_RECIPIENT=nazar.drygalo@gmail.com
# Optional production site origin used to validate browser form submissions.
PUBLIC_SITE_ORIGIN=https://nazarschoolofmath.com
# Optional long random value for irreversible application rate-limit keys.
# When omitted, the server-only Supabase service-role key is used.
RATE_LIMIT_SECRET=
# Used by `npm start`; defaults to 3000.
PORT=3000

# Supabase project URL and browser-safe publishable/anon key. These may be used
# by future authenticated frontend features; do not put a service role key here.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your_publishable_or_anon_key_here
# Server-only. Never prefix with VITE_ and never expose it to browser code.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here
