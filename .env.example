# Required to send applications through Resend (https://resend.com)
RESEND_API_KEY=re_your_key_here
# Optional. Without a domain, Resend's testing sender is used and can only
# deliver to the email address on the Resend account. Add this after buying
# and verifying a domain, for example:
FROM_EMAIL=Nazar's School of Mathematics <applications@yourdomain.com>
# Optional. Defaults to nazar.drygalo@gmail.com.
APPLICATION_RECIPIENT=nazar.drygalo@gmail.com
# Optional production site origin used to validate browser form submissions.
PUBLIC_SITE_ORIGIN=https://nazarschoolofmath.com
# Optional long random value for irreversible application rate-limit keys.
# When omitted, the server-only Supabase service-role key is used.
RATE_LIMIT_SECRET=
# Server-only credential used by Supabase Cron for session reminders.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
REMINDER_CRON_SECRET=your_long_random_reminder_secret_here
# Used by `npm start`; defaults to 3000.
PORT=3000

# Supabase project URL and browser-safe publishable/anon key. These may be used
# by future authenticated frontend features; do not put a service role key here.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your_publishable_or_anon_key_here
# Server-only. Never prefix with VITE_ and never expose it to browser code.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# Cloudflare Turnstile. The site key is browser-safe; the secret is server-only.
# For local testing, Cloudflare's always-pass keys are:
# VITE_TURNSTILE_SITE_KEY=1x00000000000000000000AA
# TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
VITE_TURNSTILE_SITE_KEY=your_turnstile_site_key_here
TURNSTILE_SECRET_KEY=your_turnstile_secret_key_here

# Optional Google Calendar synchronization. Create a Google OAuth web client,
# authorize the callback below, and generate the encryption key with:
# node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
GOOGLE_CALENDAR_CLIENT_ID=your_google_oauth_client_id
GOOGLE_CALENDAR_CLIENT_SECRET=your_google_oauth_client_secret
GOOGLE_CALENDAR_TOKEN_ENCRYPTION_KEY=your_32_byte_base64_key
GOOGLE_CALENDAR_REDIRECT_URI=https://nazarschoolofmath.com/api/integrations/google-calendar/callback
